# ===== APPLICATION SETTINGS =====
APP_NAME=POS Offline System
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# ===== DATABASE CONFIGURATION =====
DATABASE_URL=sqlite:///./pos.db
DATABASE_ECHO=False

# ===== PAYMENT GATEWAY - MIDTRANS =====
MIDTRANS_ENABLED=True
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_SERVER_KEY=your_server_key_here
MIDTRANS_CLIENT_KEY=your_client_key_here
MIDTRANS_MERCHANT_ID=your_merchant_id
MIDTRANS_API_URL=https://api.sandbox.midtrans.com/v2

# ===== TOKO/STORE CONFIGURATION =====
STORE_NAME=Toko Saya
STORE_ADDRESS=Jl. Contoh No. 123, Jakarta
STORE_PHONE=021-123456789
STORE_EMAIL=toko@example.com
STORE_TAX_ID=123.456.789.000-123
STORE_CURRENCY=IDR

# ===== SECURITY =====
SECRET_KEY=your_secret_key_for_encryption_here
PASSWORD_HASH_ALGORITHM=bcrypt
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/pos.log

# ===== UI/UX SETTINGS =====
THEME=dark
LANGUAGE=id
DATE_FORMAT=DD/MM/YYYY
TIME_FORMAT=HH:mm:ss
CURRENCY_FORMAT=IDR

# ===== PRINTER CONFIGURATION =====
PRINTER_THERMAL_NAME=Thermal Printer
PRINTER_THERMAL_PAPER_WIDTH=80

# ===== BACKUP SETTINGS =====
BACKUP_ENABLED=True
BACKUP_SCHEDULE=daily
BACKUP_TIME=02:00
BACKUP_RETENTION_DAYS=30

# ===== FEATURE FLAGS =====
FEATURE_CUSTOMER_LOYALTY=True
FEATURE_ONLINE_PAYMENTS=True
FEATURE_MULTI_TOKO=False
FEATURE_CLOUD_SYNC=False
